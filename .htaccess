RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.dutchgoose\.nl [NC]
RewriteRule ^(.*)$ https://dutchgoose.nl/$1 [R=301,L]

# Redirect /index.html to / for canonical consistency (incl. query-strings)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html[\s?] [OR]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
RewriteRule ^index\.html$ / [R=301,L]

Options -Indexes
RewriteEngine On

# === 404 FIX BATCH 27-04-2026 (Google Search Console) ===

# === Tools cleanup mei 2026 ===
# Legacy /tools.html is vervangen door /tools/ (directory hub) met losse tool-pagina's
RedirectMatch 301 ^/tools\.html$ /tools/
RedirectMatch 301 ^/tools/eiwit-calculator\.html$ /tools/eiwit-calculator/
RedirectMatch 301 ^/tools/fase-checker\.html$ /tools/fase-checker/
RedirectMatch 301 ^/tools/eet-timer\.html$ /tools/eet-timer/

# Bypass vs sleeve verhuisd van /tools/ naar /blog/ (artikel, geen tool) mei 2026
RedirectMatch 301 ^/tools/bypass-vs-sleeve\.html$ /blog/bypass-vs-sleeve.html

# Redirects naar bestaande pagina's met juiste naam
Redirect 301 /kosten-maagverkleining.html /blog/kosten-maagverkleining-wat-kost-het-echt.html
Redirect 301 /blog/plateaus-na-maagverkleining-wanneer-is-stilstand-echt-een-plateau.html /blog/plateaus-wat-is-het-en-wanneer-is-het-echt-een-plateau.html
Redirect 301 /blog/plateaus-na-maagverkleining.html /blog/plateaus-wat-is-het-en-wanneer-is-het-echt-een-plateau.html
Redirect 301 /blog/zelfbeeld-na-maagverkleining.html /blog.html
Redirect 301 /recepten/proteine-kwark-granola.html /recepten/
Redirect 301 /recepten/vaste-voeding/proteine-kwark-granola-maagverkleining.html /recepten/vaste-voeding/
Redirect 301 /disclaimer.html /disclosure.html

# Tools en blog directory zonder slash en zonder .html
RedirectMatch 301 ^/tools$ /tools/
RedirectMatch 301 ^/blog$ /blog.html

# Algemene fallback: extension-less URL automatisch naar .html versie
# Lost o.a. op: /blog/eiwit-doelen-per-dag-simpele-richtlijn-na-maagverkleining
# en /disclosure en /blog/haaruitval-na-maagverkleining-oorzaak-en-aanpak
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ /$1.html [R=301,L]

# 404 error page
ErrorDocument 404 /404.html

