# === Mediakit juli 2026 ===
# Bereikbaar op /mediakit, bewust nergens naartoe gelinkt en niet in sitemap.
# Geen Disallow in robots.txt: Google moet de URL kunnen crawlen om de
# noindex-header te zien. De X-Robots-Tag is de bescherming, niet robots.txt.
<Files "mediakit.pdf">
  <IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow"
  </IfModule>
</Files>

RewriteRule ^mediakit/?$ /mediakit.pdf [L]
